<script src='https://cdn.jsdelivr.net/npm/theia-sticky-sidebar@1.7.0/dist/theia-sticky-sidebar.min.js'></script>
<script>
document.addEventListener("DOMContentLoaded", function () {

  const allAnswers = document.querySelectorAll('.collapseomatic_content');

  allAnswers.forEach(el => {
    el.style.maxHeight = '0';
    el.style.overflow = 'hidden';
    el.style.transition = 'max-height 0.3s ease';
  });

  document.querySelectorAll('.collapseomatic').forEach(btn => {

    btn.addEventListener('click', function(e) {
      e.preventDefault();

      const target = document.getElementById('target-' + this.id);
      if (!target) return;

      // Close all first
      allAnswers.forEach(el => {
        if (el !== target) el.style.maxHeight = '0';
      });

      // Toggle current
      if (target.style.maxHeight === '0px' || !target.style.maxHeight) {
        target.style.maxHeight = target.scrollHeight + 'px';
      } else {
        target.style.maxHeight = '0';
      }

    });

  });

});
</script>
<script>
document.addEventListener("DOMContentLoaded", function(){
  try {
