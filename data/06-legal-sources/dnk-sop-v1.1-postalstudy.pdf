  } catch(e){}
});
</script>
<script>
window.addEventListener('load', function () {

  function initRelatedPosts() {

    var related = document.getElementById('related-wrap');

    if (related) {
      related.style.visibility = 'visible';
      related.style.opacity = '1';
    }

    document.querySelectorAll('.related-posts img').forEach(function(img){

      img.setAttribute('loading','lazy');
      img.setAttribute('decoding','async');
      img.setAttribute('fetchpriority','low');

    });

  }

  if ('requestIdleCallback' in window) {

    requestIdleCallback(initRelatedPosts);

  } else {

    setTimeout(initRelatedPosts, 2500);

  }

});
</script>
<script>
//<![CDATA[
document.addEventListener('DOMContentLoaded', function () {

  if (window.innerWidth <= 768) {

    document.body.classList.add('mobile-view');

  }

});
//]]>
</script>

