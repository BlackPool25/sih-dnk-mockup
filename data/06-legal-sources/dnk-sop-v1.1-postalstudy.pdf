}.status-msg-wrap {margin: 0 auto 25px;text-transform: uppercase;font-size: 11px }.status-msg-border {border: 2px solid #eee;opacity: .7;border-radius: 2px }.status-msg-bg {background-color: #f8f8f8;opacity: 1;filter: none }.feed-links {clear: both;display: none;line-height: 2.5em }#data-type, #data-results, #data-label {display: none }
/* ================= GLOBAL FONT ================= */
html, body {
font-family: system-ui, -apple-system, BlinkMacSystemFont,
"Segoe UI", Arial, sans-serif;
}
/* ================= BODY ================= */
body {
background: #ffffff;
font-family: inherit;
font-weight: 400;
font-style: normal;
font-size: 16px;
color: #333;
word-wrap: break-word;
margin: 0;
padding: 0;
}
/* ================= HEADINGS ================= */
h1, h2, h3, h4, h5, h6 {
font-family: inherit;
font-weight: 700;
}
/* ================= OPTIONAL SAFETY ================= */
body, .post, .widget, .sidebar, .menu {
font-family: inherit;
}
