}.post-nav .prev .nav-thumb{float:left;margin-right:10px }.post-nav .next .nav-thumb{float:right;margin-left:10px }.post-nav .nav-content,.post-nav .nav-inner{overflow:hidden }.post-nav li span{display:block;padding:0 0 5px;font-size:12px;letter-spacing:1px;font-family: system-ui, Arial, sans-serif;font-weight:700;font-style:normal;text-transform:uppercase }
