<script>
//<![CDATA[
document.addEventListener("DOMContentLoaded", function() {

  /* ACCESSIBILITY FIX */
  function fixPagerAccessibility(){
    var pager = document.querySelector('#blog-pager');
    if(!pager) return;

    var links = pager.querySelectorAll('a');

    links.forEach(function(link){
      var pageText = link.textContent.trim();

      if(pageText){
        link.setAttribute('aria-label','Go to page ' + pageText);
        link.setAttribute('title','Page ' + pageText);
      } else {
        link.setAttribute('aria-label','Pagination link');
      }
    });
  }

  setTimeout(fixPagerAccessibility, 1000);

});
//]]>
</script>
<div class='back-top' title='Back to Top'>
<a aria-label='Back to Top' href='#top'>
<svg aria-hidden='true' fill='currentColor' focusable='false' height='18' viewBox='0 0 24 24' width='18'>
<path d='M7 14l5-5 5 5H7z'></path>
</svg>
</a>
</div>
</div>
<script>
//<![CDATA[
(function(){

/* ================= CRITICAL (FAST LOAD) ================= */
document.addEventListener("DOMContentLoaded", function () {

  /* PRELOADER */
  const pre = document.getElementById("preloader");
  if (pre) pre.remove();

  /* ACCESSIBILITY */
  document.querySelectorAll('select[id^="BlogArchive"]').forEach(el=>{
    el.setAttribute("aria-label","Blog Archive");
  });

  /* IMAGE OPTIMIZATION (OPTIMIZED LOOP) */
  const imgs = document.querySelectorAll("img:not([loading])");
  for(let i=0;i<imgs.length;i++){
    if(i===0){
      imgs[i].loading="eager";
      imgs[i].fetchPriority="high";
    }else{
      imgs[i].loading="lazy";
      imgs[i].decoding="async";
    }
  }

});

/* ================= NON-CRITICAL (DELAYED) ================= */
window.addEventListener("load", function(){

  setTimeout(function(){

    /* SCROLL PROGRESS */
    const progress=document.querySelector("progress");
    const fallback=document.querySelector(".progress-bar");

    function updateProgress(){
      const max=document.documentElement.scrollHeight-window.innerHeight;
      const value=window.scrollY;

      if(progress){
        progress.max=max;
        progress.value=value;
      }else if(fallback){
        fallback.style.width=(value/max*100)+"%";
      }
    }

    window.addEventListener("scroll",updateProgress,{passive:true});
    window.addEventListener("resize",updateProgress);
    updateProgress();


    /* ================= WHATSAPP POPUP ================= */
    const SHOW_INTERVAL = 86400000;
    const lastShown = +localStorage.getItem("waPopupTime");

    if (!lastShown || Date.now() - lastShown > SHOW_INTERVAL) {

      const overlay = document.getElementById("waOverlay");
      const popup = document.getElementById("waPopup");
      const closeBtn = document.getElementById("closePopup");

      if (!overlay || !popup || !closeBtn) return;

      const variants = [
        {title:"📢 Join WhatsApp Channel",text:"Get daily MCQs & updates regularly"},
        {title:"Many Staff Joined",text:"Don't miss Regular MCQs & updates"}
      ];

      const selected = variants[Math.floor(Math.random() * variants.length)];

      document.getElementById("popupTitle").innerText = selected.title;
      document.getElementById("popupText").innerText = selected.text;

      let shown = false;

      function showPopup(){
        if (shown) return;
        shown = true;

        overlay.classList.add("show");
        document.body.style.overflow = "hidden";

        setTimeout(()=> closeBtn.classList.add("active"),4000);

        localStorage.setItem("waPopupTime", Date.now());
      }

      /* only scroll trigger (optimized) */
      window.addEventListener("scroll", function onScroll(){
        if(window.scrollY > 800){
          showPopup();
          window.removeEventListener("scroll", onScroll);
        }
      }, {passive:true});

      setTimeout(showPopup, 7000);

      popup.addEventListener("click", e=>e.stopPropagation());
      overlay.addEventListener("click", e=>e.stopPropagation());

      closeBtn.onclick = function(e){
        e.stopPropagation();
        if(!closeBtn.classList.contains("active")) return;

        overlay.classList.remove("show");
        document.body.style.overflow = "auto";
      };

    }

    /* COMMENTS FIX (NO INTERVAL) */
    const commentLink=document.getElementById("comment-editor-src");
    if(commentLink){
      commentLink.setAttribute("aria-label","Write a Comment");
      commentLink.setAttribute("title","Write a Comment");
      if(!commentLink.innerHTML.trim()){
        commentLink.innerHTML="Write a Comment";
      }
    }

    setTimeout(function(){
      const iframe=document.getElementById("comment-editor");
      if(iframe){
        iframe.setAttribute("title","Comment editor");
      }
    },1000);

  },2000);

});

/* ================= ANALYTICS (LAZY) ================= */
let analyticsLoaded=false;

function loadAnalytics(){
  if(analyticsLoaded) return;
  analyticsLoaded=true;

  const s=document.createElement("script");
  s.src="https://www.googletagmanager.com/gtag/js?id=G-3MJDLT39VE";
  s.async=true;
  document.head.appendChild(s);

  window.dataLayer=window.dataLayer||[];
  function gtag(){dataLayer.push(arguments);}
  window.gtag=gtag;

  gtag('js',new Date());
  gtag('config','G-3MJDLT39VE');
}

/* removed scroll trigger */
["click","keydown","touchstart"].forEach(e=>{
  window.addEventListener(e,loadAnalytics,{once:true});
});



/* ================= ADS (IDLE LOAD - OPTIMIZED) ================= */
window.addEventListener("load", function () {

  function loadAds() {
    const s = document.createElement("script");
    s.src = "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2298822478618041";
    s.async = true;
    s.crossOrigin = "anonymous";

    s.onload = function () {
      // Push ads ONLY after script is fully loaded
      document.querySelectorAll(".adsbygoogle").forEach(function (ad) {
        try {
          (adsbygoogle = window.adsbygoogle || []).push({});
        } catch (e) {}
      });
    };

    document.body.appendChild(s);
  }

  if ('requestIdleCallback' in window) {
    requestIdleCallback(loadAds);
  } else {
    setTimeout(loadAds, 10); // reduced delay for better balance
  }

});



/* ================= RECAPTCHA (ONLY WHEN NEEDED) ================= */
if(location.href.includes("contact")){
  const s=document.createElement("script");
  s.src="https://www.google.com/recaptcha/api.js";
  s.async=true;
  document.head.appendChild(s);
}


/* ================= ERROR HANDLER ================= */
window.addEventListener("error",function(e){
  console.warn("Handled JS Error:",e.message);
});

})();
//]]>
</script>
<script type='text/javascript'>
//<![CDATA[
document.addEventListener("DOMContentLoaded", function () {

  const accordionItemHeaders =
    document.querySelectorAll(".accordion-item-header");

  accordionItemHeaders.forEach(function(accordionItemHeader) {

    accordionItemHeader.addEventListener("click", function () {

      accordionItemHeader.classList.toggle("active");

      const accordionItemBody =
        accordionItemHeader.parentElement.querySelector(".accordion-item-body");

      if (accordionItemHeader.classList.contains("active")) {

        accordionItemBody.style.maxHeight =
          accordionItemBody.scrollHeight + "px";

      } else {

        accordionItemBody.style.maxHeight = 0;

      }

    });

  });

});
//]]>
</script>
