<style id='wp-custom-css' type='text/css'>
			
/***** Alert Message ********/
.alert-message.answer {
    background-color: #3aaf3e47;
    border-color: #17732fa6;
    color: #000;
	  margin: 5px 0;
}
.alert-message.answer i.fa{
	color: green;
}
.alert-message.hint {
    background-color: #0400ff0d;
    border-color: #001fff47;
    color: #000;
	  margin: 7px 0 2px 0;
}
.alert-message.hint a, .alert-message.answer a{
	color: #289dcc;
}
.alert-message.success {
    background-color: #ff00000d;
    border-color: #ff000030;
    color: #000;
	font-weight: bold;
}
.alert-message.link {
    background-color: #303440;
    border-color: #f6be00;
    color: #fff;
	font-weight: bold;
}
.alert-message.link ul {
    margin-bottom: 0px;
}
.alert-message.link ul li {
    line-height: 1.3 !important;
    padding-top: unset;
}
.alert-message {
    position: relative;
    display: block;
    background-color: #FAFAFA;
    padding: 20px;
    margin: 20px 0;
    -webkit-border-radius: 2px;
    -moz-border-radius: 2px;
    border-radius: 2px;
    color: #2f3239;
    border: 1px solid;
}
a.linkto:link {
	text-decoration: none;
}
.alert-message.success i {
  color: #ec9a53;
}
.alert-message.success ul {
  margin-bottom: 0px;
}
/******* Custom Button *****/
button.seeanswer{
  background:#1AAB8A;
  color:#fff;
  border:none;
  position:relative;
  cursor:pointer;
  transition:800ms ease all;
  outline:none;
	font-weight: bold;
	font-size: 16px;
	padding: 5px 16px;margin-left: auto;
    margin-right: auto;display:block;width:100px;height:30px;
}
button.seeanswer:hover{
  background:#fff;
  color:#1AAB8A;
}
button.seeanswer:before,button:after{
  content:"";
  position:absolute;
  top:0;
  right:0;
  height:2px;
  width:0;
  background: #1AAB8A;
  transition:400ms ease all;
}
button.seeanswer:after{
  right:inherit;
  top:inherit;
  left:0;
  bottom:0;
}
button.seeanswer:hover:before,button.seeanswer:hover:after{
  width:100%;
  transition:800ms ease all;
}
button.seeanswer i.fa{
	color: #fff;
}
button.seeanswer:hover i.fa{
	color: #1AAB8A;
}
/*Label for qcm*/
span#qcm.label-info{
	background-color: #f47575;
}
span#qcm.label{
    display: inline;
    padding: .2em .6em .3em;
    font-size: 89%;
    font-weight: bold;
    line-height: 1;
    color: #fff;
    text-align: center;
    white-space: nowrap;
    vertical-align: baseline;
    border-radius: .25em;
}




</style>
