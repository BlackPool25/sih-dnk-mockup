DB_PASSWORD=changeme
DB_PORT=5433
POSTGRES_DB=sih_dnk
POSTGRES_USER=sih_dnk
DATABASE_URL=postgresql+psycopg://sih_dnk:changeme@localhost:5433/sih_dnk
REDIS_URL=redis://127.0.0.1:6379/0

# JWT / Encryption — dev defaults; rotate for production
JWT_SECRET_KEY=this-is-a-dev-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ENCRYPTION_MASTER_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Optional LLM / voice-provider keys.  Absent ⇒ deterministic extractor +
# template replies (no network).  SARVAM_ENABLED=true switches voice to the
# Sarvam API (STT/TTS/translate).
GEMINI_API_KEY=
SARVAM_API_KEY=
SARVAM_ENABLED=false

# Razorpay (pricing-engine / backend-core payments) — leave empty for offline dev
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
RAZORPAY_API_BASE=https://api.razorpay.com/v1

# Tracking
TRACKING_PROVIDER=mock
TRACK17_API_KEY=

# Downstream engine URLs — compose defaults use service names; host dev overrides use 127.0.0.1
VALIDATION_ENGINE_URL=http://validation-engine:8000
PRICING_ENGINE_URL=http://pricing-engine:8000
TRACKING_API_URL=http://tracking-api:8000
VOICE_PIPELINE_URL=http://voice-pipeline:8000

# Host-dev overrides (uncomment when running services outside compose):
# VALIDATION_ENGINE_URL=http://127.0.0.1:8001
# PRICING_ENGINE_URL=http://127.0.0.1:8003
# TRACKING_API_URL=http://127.0.0.1:8004
# VOICE_PIPELINE_URL=http://127.0.0.1:8002
